# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Get these from your Supabase project: Project Settings → API
# (or, if you created Supabase through the Vercel Marketplace,
#  these are auto-synced to your Vercel project's env vars).
# ─────────────────────────────────────────────────────────────

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser or commit.
# Used by the seed script and the cron data-update route to write
# the dictionary tables (bypasses row-level security).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Secret that protects the cron endpoint from public calls.
# Make up any long random string; set the same value in Vercel.
CRON_SECRET=make-up-a-long-random-string-here

# Base URL of the deployed site (used for magic-link redirects).
# Local dev: http://localhost:3000  |  Production: your vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
